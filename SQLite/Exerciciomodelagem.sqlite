SELECT STRFTIME('%m', "criado") AS "total", count(*) AS "Contagem" FROM "usuarios" GROUP BY "criado";

CREATE TABLE "cursos" (
 "id" INTEGER NOT NULL PRIMARY KEY,
 "slug" TEXT NOT NULL UNIQUE,
 "titulo" TEXT NOT NULL UNIQUE,
 "descricao" TEXT NOT NULL UNIQUE,
 "aulas" INTEGER NOT NULL,
 "horas" INTEGER NOT NULL,
 "criado" TEXT DEFAULT CURRENT_TIMESTAMP
) STRICT;

INSERT INTO cursos ("id", "slug", "titulo", "descricao", "aulas", "horas") 
VALUES (1, 'Javascript-basico', 'JavaScript Básico', 'Aprenda os fundamentos da linguagem Java Script', '20', '5');

CREATE TABLE "lessons" (
 "id" INTEGER NOT NULL PRIMARY KEY,
 "course_id" INTEGER NOT NULL UNIQUE,
 "slug" TEXT NOT NULL UNIQUE,
 "title" TEXT NOT NULL UNIQUE,
 "materia" TEXT NOT NULL,
 "materia_slug" TEXT NOT NULL,
 "seconds" INTEGER NOT NULL,
 "video" TEXT NOT NULL UNIQUE,
 "description" TEXT NOT NULL UNIQUE,
 "lesson_order" INTEGER NOT NULL UNIQUE,
 "free" INTEGER NOT NULL UNIQUE,
 "criado" TEXT DEFAULT CURRENT_TIMESTAMP,
 FOREIGN KEY ("course_id") REFERENCES cursos ("id")
) STRICT;

DROP TABLE usuarios;

INSERT INTO lessons ("id", "course_id", "slug", "title", "materia", "materia_slug", "seconds", "video", "description", "lesson_order", "free")
VALUES (101, 1, 'variaveis-let-const', 'Variáveis: let e const', 'Fundamentos', 'fundamentos', 480, 'variaveis.mp4', 'Entenda a diferença entre let, const e var.', 3, 1);

CREATE TABLE lessonsCompleted (
"user_id" INTEGER NOT NULL UNIQUE,
"course_id" INTEGER NOT NULL UNIQUE,
"lesson_id" INTEGER NOT NULL UNIQUE,
"criado" TEXT DEFAULT CURRENT_TIMESTAMP,
FOREIGN KEY ("lesson_id") REFERENCES lessons ("id"),
FOREIGN KEY ("user_id") REFERENCES usuarios ("id"),
FOREIGN KEY ("course_id") REFERENCES cursos ("id")
) STRICT;

INSERT INTO lessonsCompleted ("user_id", "course_id", "lesson_id")
VALUES (42, 1, 101);

CREATE TABLE certificates (
 "id" TEXT NOT NULL PRIMARY KEY,
 "user_id" INTEGER NOT NULL,
 "course_id" INTEGER NOT NULL,
 "criado" TEXT DEFAULT CURRENT_TIMESTAMP,
 FOREIGN KEY ("user_id") REFERENCES usuarios ("id"),
 FOREIGN KEY ("course_id") REFERENCES cursos ("id")
) STRICT;

INSERT INTO certificates ("id", "user_id", "course_id")
VALUES ('aq32scsqd', 42, 1);

