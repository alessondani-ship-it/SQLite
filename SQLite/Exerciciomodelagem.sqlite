-- database: ./Exerciciomodelagem.sqlite

CREATE TABLE "usuarios" (
"id" INTEGER NOT NULL PRIMARY KEY, 
"nome" TEXT NOT NULL UNIQUE, 
"senha" TEXT NOT NULL UNIQUE, 
"email" TEXT NOT NULL UNIQUE, 
"tipo_id" INTEGER,
"criado" TEXT DEFAULT CURRENT_TIMESTAMP,
FOREIGN KEY ("tipo_id") REFERENCES "tipagem" ("id")
) STRICT;

CREATE TABLE "tipagem" (
"id" INTEGER PRIMARY KEY,
"tipo" TEXT UNIQUE,
"aluno" INTEGER CHECK ("aluno" IN (0, 1)),
"admin" INTEGER CHECK ("admin" IN (0, 1))
) STRICT;

INSERT INTO usuarios ("id", "nome", "senha", "email") VALUES (42, 'André', 'senha123', 'Andre@gmail.com');
